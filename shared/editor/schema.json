{
  "version": 1,
  "fieldTypes": "text, textarea, number, bool, select, list (komma-gescheiden), json, app, preset, plugin, pluginAction, pluginWidget, steps",
  "actions": [
    { "type": "media.playPause", "group": "Media", "name": "Play / pauze" },
    { "type": "media.next", "group": "Media", "name": "Volgende" },
    { "type": "media.previous", "group": "Media", "name": "Vorige" },

    { "type": "audio.volumeUp", "group": "Geluid", "name": "Volume hoger" },
    { "type": "audio.volumeDown", "group": "Geluid", "name": "Volume lager" },
    { "type": "audio.mute", "group": "Geluid", "name": "Geluid aan/uit", "state": true },
    { "type": "audio.micMute", "group": "Geluid", "name": "Microfoon aan/uit", "state": true },
    { "type": "audio.volume", "group": "Geluid", "name": "Volume (schuif/draaiknop)", "slider": true },
    { "type": "audio.micVolume", "group": "Geluid", "name": "Microfoonvolume (schuif/draaiknop)", "slider": true },

    { "type": "app.open", "group": "Apps en links", "name": "App openen",
      "fields": [{ "key": "app", "label": "App", "type": "app", "required": true }] },
    { "type": "url.open", "group": "Apps en links", "name": "Link openen",
      "fields": [{ "key": "url", "label": "Adres", "type": "text", "placeholder": "https://…", "required": true }] },

    { "type": "keys.press", "group": "Toetsen", "name": "Toetscombinatie",
      "fields": [{ "key": "keys", "label": "Toetsen", "type": "text", "placeholder": "cmd+shift+a, f5, ctrl+up", "required": true }] },
    { "type": "text.type", "group": "Toetsen", "name": "Tekst typen",
      "fields": [{ "key": "text", "label": "Tekst", "type": "textarea", "required": true }] },
    { "type": "preset", "group": "Toetsen", "name": "Sneltoets uit de bibliotheek",
      "fields": [{ "key": "preset", "label": "Sneltoets", "type": "preset", "required": true }] },

    { "type": "shortcut.run", "group": "Automatisering", "name": "Opdracht (Opdrachten-app)", "platforms": ["macos"],
      "fields": [{ "key": "shortcut", "label": "Naam van de opdracht", "type": "text", "required": true }] },
    { "type": "macro", "group": "Automatisering", "name": "Macro (meerdere stappen)",
      "fields": [{ "key": "steps", "label": "Stappen", "type": "steps", "required": true }] },
    { "type": "delay", "group": "Automatisering", "name": "Pauze (alleen in een macro)", "macroOnly": true,
      "fields": [{ "key": "ms", "label": "Milliseconden", "type": "number", "placeholder": "500", "required": true }] },

    { "type": "system.darkMode", "group": "Systeem", "name": "Dark mode aan/uit", "state": true },
    { "type": "system.keepAwake", "group": "Systeem", "name": "Wakker houden aan/uit", "state": true },
    { "type": "system.lock", "group": "Systeem", "name": "Vergrendelen" },
    { "type": "system.displayOff", "group": "Systeem", "name": "Scherm uit" },
    { "type": "system.screenshot", "group": "Systeem", "name": "Screenshot" },
    { "type": "system.screenshotArea", "group": "Systeem", "name": "Screenshot van selectie" },
    { "type": "pointer.scroll", "group": "Systeem", "name": "Scrollen (draaiknop)", "dialOnly": true },

    { "type": "ha.toggle", "group": "Smart home", "name": "Home Assistant aan/uit",
      "fields": [{ "key": "entity", "label": "Entiteit", "type": "text", "placeholder": "light.woonkamer", "required": true }] },
    { "type": "ha.service", "group": "Smart home", "name": "Home Assistant-dienst",
      "fields": [
        { "key": "service", "label": "Dienst", "type": "text", "placeholder": "light.turn_on", "required": true },
        { "key": "entity", "label": "Entiteit", "type": "text", "placeholder": "light.bureau of all" },
        { "key": "data", "label": "Gegevens (JSON)", "type": "json", "placeholder": "{\"brightness_pct\": 30}" }] },
    { "type": "ha.level", "group": "Smart home", "name": "Home Assistant-niveau (schuif/draaiknop)", "slider": true,
      "fields": [{ "key": "entity", "label": "Entiteit", "type": "text", "placeholder": "light.woonkamer", "required": true }] },
    { "type": "mqtt.publish", "group": "Smart home", "name": "MQTT-bericht",
      "fields": [
        { "key": "topic", "label": "Topic", "type": "text", "required": true },
        { "key": "payload", "label": "Bericht", "type": "text" },
        { "key": "retain", "label": "Bewaren (retain)", "type": "bool" }] },
    { "type": "webhook.call", "group": "Smart home", "name": "Webhook",
      "fields": [
        { "key": "webhook", "label": "Naam uit integrations.json", "type": "text" },
        { "key": "url", "label": "of adres", "type": "text", "placeholder": "https://…" },
        { "key": "method", "label": "Methode", "type": "select", "options": ["", "GET", "POST", "PUT", "PATCH", "DELETE"] },
        { "key": "body", "label": "Inhoud", "type": "textarea" },
        { "key": "headers", "label": "Headers (JSON)", "type": "json" }] },

    { "type": "plugin", "group": "Plugins", "name": "Plugin-actie",
      "fields": [
        { "key": "plugin", "label": "Plugin", "type": "plugin", "required": true },
        { "key": "action", "label": "Actie", "type": "pluginAction", "required": true },
        { "key": "params", "label": "Parameters (JSON)", "type": "json" }] }
  ],
  "kinds": [
    { "kind": "button", "name": "Knop", "actions": ["action", "longPress", "doubleTap"], "toggle": true },
    { "kind": "slider", "name": "Schuif", "actions": ["action"], "sliderOnly": true },
    { "kind": "dial", "name": "Draaiknop", "actions": ["action", "offAction"], "dial": true,
      "config": [{ "key": "step", "label": "Stap (0–0,5)", "type": "number", "placeholder": "0.03" },
                 { "key": "speed", "label": "Scrollsnelheid", "type": "number", "placeholder": "1" },
                 { "key": "natural", "label": "Natuurlijk scrollen", "type": "bool" }] },
    { "kind": "touchpad", "name": "Aanraakpad", "minW": 2, "minH": 2,
      "config": [{ "key": "speed", "label": "Snelheid", "type": "number", "placeholder": "1.5" },
                 { "key": "natural", "label": "Natuurlijk scrollen", "type": "bool" }] },
    { "kind": "clock", "name": "Klok" },
    { "kind": "agenda", "name": "Agenda",
      "config": [{ "key": "count", "label": "Aantal afspraken (1–5)", "type": "number", "placeholder": "1" }] },
    { "kind": "weather", "name": "Weer",
      "config": [{ "key": "city", "label": "Plaats", "type": "text", "placeholder": "Amsterdam" },
                 { "key": "lat", "label": "Breedtegraad", "type": "number" },
                 { "key": "lon", "label": "Lengtegraad", "type": "number" }] },
    { "kind": "nowplaying", "name": "Nu speelt",
      "config": [{ "key": "player", "label": "Speler", "type": "select", "options": ["", "music", "spotify"] }] },
    { "kind": "timer", "name": "Timer", "config": [{ "key": "seconds", "label": "Seconden", "type": "number", "placeholder": "300" }] },
    { "kind": "pomodoro", "name": "Pomodoro",
      "config": [{ "key": "work", "label": "Werk (min)", "type": "number", "placeholder": "25" },
                 { "key": "rest", "label": "Pauze (min)", "type": "number", "placeholder": "5" }] },
    { "kind": "worldclock", "name": "Wereldklok",
      "config": [{ "key": "zones", "label": "Tijdzones", "type": "zones" }] },
    { "kind": "photos", "name": "Foto's",
      "config": [{ "key": "folder", "label": "Map", "type": "text", "placeholder": "~/Pictures/Cyberpad" },
                 { "key": "seconds", "label": "Seconden per foto", "type": "number", "placeholder": "10" }] },
    { "kind": "stats", "name": "Systeem",
      "config": [{ "key": "show", "label": "Tonen", "type": "list", "placeholder": "cpu, ram, net, battery, accessories" }] },
    { "kind": "terminal", "name": "Terminal",
      "config": [{ "key": "command", "label": "Commando", "type": "text", "required": true },
                 { "key": "cwd", "label": "Werkmap", "type": "text", "placeholder": "~" },
                 { "key": "timeout", "label": "Max. seconden", "type": "number", "placeholder": "60" },
                 { "key": "dangerous", "label": "Gevaarlijk (2× tikken)", "type": "bool" }] },
    { "kind": "ha", "name": "Home Assistant",
      "config": [{ "key": "entity", "label": "Entiteit", "type": "text", "placeholder": "sensor.buiten_temperatuur", "required": true }] },
    { "kind": "mqtt", "name": "MQTT-waarde",
      "config": [{ "key": "topic", "label": "Topic", "type": "text", "required": true },
                 { "key": "unit", "label": "Eenheid", "type": "text" },
                 { "key": "field", "label": "Veld (JSON)", "type": "text" }] },
    { "kind": "plugin", "name": "Plugin-widget",
      "config": [{ "key": "plugin", "label": "Plugin", "type": "plugin", "required": true },
                 { "key": "widget", "label": "Widget", "type": "pluginWidget", "required": true },
                 { "key": "params", "label": "Parameters (JSON)", "type": "json" }] }
  ],
  "buttonConfig": [{ "key": "topic", "label": "MQTT-statustopic (licht op bij aan)", "type": "text" }],
  "emoji": "💡🔊🔇🎙🎤📹🖥⏯⏮⏭🔉🔈🔒🌙🌗☕️🧭🌐📸✂️🗂🪟🔎📋📥✍️🗒⚡️🎬🌚🌀🔥❄️🚪🏠🛋🛏🍳📺🎮🎧🎵📞✋👋📡🔔⏰⏱🍅🌍📷🧩🪝💬📧📅✅❌⭐️❤️🚀🛠⚙️🔑🧪📊💻⌨️🖱🖨"
}
